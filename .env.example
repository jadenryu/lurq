# ── lurq configuration ───────────────────────────────────────────────────
# Copy to `.env` and fill in. Only DATABASE_URL is strictly required to run
# `lurq sync` / `lurq serve`. Everything else degrades gracefully (§15, §17).

# Postgres connection string (must have the `vector` extension available).
# Matches the bundled docker-compose.yml below.
DATABASE_URL=

# GitHub API token — strongly recommended. Without it, GitHub signals
# (stars, issues, release cadence) are skipped and confidence/score drop.
# Create one at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# ── Embeddings (semantic search) ──────────────────────────────────────────
# Provider: "openai" (default) or "local". "openai" means any OpenAI-compatible
# /v1/embeddings endpoint — point EMBEDDING_BASE_URL at it (Together, Fireworks,
# HF TEI, …). If no EMBEDDING_API_KEY is set, lurq falls back to the local
# deterministic embedder so search still works without paid keys.
# NOTE: changing provider/model changes the vector space — re-embed the corpus
# (`lurq sync --full`). The model must return EMBEDDING_DIM (1536)-wide vectors.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Summaries + usage guides (LLM-generated at ingest) + `plan` ────────────
# Provider: "openai" or "none". "openai" means any OpenAI-compatible
# /v1/chat/completions endpoint — set SUMMARY_BASE_URL + key + model to use
# Groq, Together, Fireworks, xAI (Grok), etc. With "none" (or no key), lurq
# falls back to the npm description + a category-derived guide — never fabricated.
#   OpenAI  : https://api.openai.com/v1            gpt-4o-mini
#   Groq    : https://api.groq.com/openai/v1       llama-3.3-70b-versatile   (fastest)
#   Together: https://api.together.xyz/v1          meta-llama/Llama-3.3-70B-Instruct-Turbo
#   Fireworks: https://api.fireworks.ai/inference/v1  accounts/fireworks/models/llama-v3p3-70b-instruct
#   xAI     : https://api.x.ai/v1                  grok-2-latest
SUMMARY_PROVIDER=openai
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_BASE_URL=https://api.openai.com/v1

# ── Sandbox verification (optional) ───────────────────────────────────────
# With E2B_API_KEY set, package install + smoke-load runs in an isolated E2B
# cloud microVM (safe for UNTRUSTED packages). Without it, the local
# child-process driver is used — trusted/operator packages only. Get a key at
# https://e2b.dev.
# E2B_API_KEY=
# E2B template to launch; must have node + npm on PATH. Omit for E2B's default;
# pin a Node-versioned template for reproducible runs.
# E2B_TEMPLATE=

# ── Hosted HTTP service (`lurq serve-http`) ───────────────────────────────
# Operator-side only — these belong on YOUR service host, never on a user's
# machine. Users connect to the endpoint with an API key (`lurq install`);
# DATABASE_URL stays server-side. See docs/lurq-hosted-deployment.md.
# Port to listen on (Railway injects PORT automatically).
PORT=8080
# Per-API-key request cap per window, and a coarser per-IP cap (floods).
LURQ_RATE_LIMIT_MAX=120
LURQ_IP_RATE_LIMIT_MAX=240
LURQ_RATE_LIMIT_WINDOW_MS=60000
# Bearer token to expose GET /metrics (per-tool call/error/latency in Prometheus
# format). Leave unset to disable the endpoint (returns 404).
# LURQ_METRICS_TOKEN=
# Shared secret for self-serve key issuance (POST /keys). The Clerk-authenticated
# web app presents it to mint a key for a signed-in user. Set the SAME value on
# the web app (as LURQ_ISSUER_SECRET). Unset → the endpoint is disabled (404).
# LURQ_ISSUER_SECRET=

# ── Client-side (talking to a remote endpoint) ────────────────────────────
# Only needed to point the CLI/wizard at a non-default endpoint or to pre-seed
# the key non-interactively. The wizard writes these into agent config, not here.
# LURQ_ENDPOINT=https://api.lurq.run/mcp
# LURQ_API_KEY=

# ── Caching (optional) ────────────────────────────────────────────────────
# Distributed response cache for recommend/evaluate/compare. With no REDIS_URL
# the response cache is OFF — every request recomputes against Postgres (fine
# for a single instance / local use; set it before serving real traffic, since
# it also backs the rate limiter across instances). Note this is separate from
# the on-disk HTTP cache below, which is always on.
# REDIS_URL=redis://localhost:6379
# Override the on-disk HTTP cache location (default: ~/.cache/lurq/http).
# LURQ_CACHE_DIR=
# TTL in seconds for the response cache.
# LURQ_CACHE_TTL_SEC=

# ── Pre-launch gate (operator only) ───────────────────────────────────────
# When set, lets the owner run CLI commands while the public gate is on. See
# src/core/gate.ts. Leave unset for normal use.
# LURQ_OWNER_KEY=

# ── Destructive-op guard (operator only) ──────────────────────────────────
# `lurq db reset` DROPs the whole schema and refuses to run against a non-local
# database. Set to 1 only when you genuinely mean to wipe a remote one.
# LURQ_ALLOW_REMOTE_RESET=

# ── Benchmark participants (operator only) ────────────────────────────────
# Model keys for `lurq-benchmark` / the miss-rate harness. Not read by the CLI,
# the MCP server, or the ingest pipeline.
# CLAUDE_API_KEY=
# GEMINI_API_KEY=
# Point the bakeoff at the live API instead of the local DB.
# USE_LIVE_API=

# ── Tuning ────────────────────────────────────────────────────────────────
# Parallel ingest workers.
LURQ_SYNC_CONCURRENCY=5
# Stalest non-seed packages the daily sync refreshes on top of the seed list.
# index size / this = days for a discovered package to come back around. 0 =
# seeds only (leaves everything discovery ingested frozen at its ingest date).
LURQ_SYNC_REFRESH_CAP=400
# error | warn | info | debug
LOG_LEVEL=info

# Default-sort composite blend λ (§1/§4): composite = (1−λ)·health + λ·quality.
# 0 = pure popularity/health, 1 = pure intrinsic quality. Overridable per-user via
# `lurq edit-weights --set composite.lambda=…`; this env var wins over both.
# LURQ_COMPOSITE_LAMBDA=0.35

# ── GitHub App: repo autopilot ────────────────────────────────────────────
# Create the App at github.com/settings/apps with:
#   Permissions: Contents (read-only), Metadata (read-only)  <- read-only, always
#   Callback URL: https://<web-host>/api/github/callback
#   Webhooks: not needed
#
# API SERVICE (Railway) — both required, or /repos stays disabled (404):
# LURQ_GITHUB_APP_ID=
# PEM contents. Literal newlines or \n escapes both work.
# LURQ_GITHUB_APP_PRIVATE_KEY=
#
# WEB APP (Vercel) — the slug from the App's public page URL. Only the web app
# needs it, to build the "Connect GitHub" install link.
# LURQ_GITHUB_APP_SLUG=
#
# The web app also needs LURQ_ISSUER_SECRET (shared with the API service): it
# signs the install `state` that binds a callback to the signed-in user.

# ── Users' CI (their repo secrets, not yours) ─────────────────────────────
# The generated workflow reads these from the user's OWN repository secrets.
# None of them is ever set here.
#   LURQ_API_KEY  - required; issued from the dashboard, used by `upgrade-plan`
# Then, only for `pr` mode (the workflow defaults to analyse-only), ONE of:
#   ANTHROPIC_API_KEY        - bills per token
#   CLAUDE_CODE_OAUTH_TOKEN  - uses an existing Claude Pro/Max subscription
# `lurq check-upgrade` needs no key at all, so the drift + breakage brief costs
# a user nothing beyond LURQ_API_KEY.
